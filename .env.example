# ============================================================
#  Nice Bingo — environment configuration
#  Copy this file to ".env" (setup.bat does this for you)
# ============================================================

# 1) BOT_TOKEN — create your bot with @BotFather on Telegram:
#    * message @BotFather  ->  /newbot
#    * choose a name and username (must end in "bot")
#    * paste the token it gives you below
BOT_TOKEN=YOUR_NEW_BOT_TOKEN_HERE

# 2) ADMIN_IDS — your numeric Telegram user id(s), comma separated.
#    Find your id by messaging @userinfobot or @getidsbot (they reply
#    with "Id: 123456789").
ADMIN_IDS=

# 3) SUPER_ADMIN_ID — the ONE admin who controls everything.
# Defaults to first ID in ADMIN_IDS if not set.
# SUPER_ADMIN_ID=
#    SUPER_ADMIN_IDS — comma-separated list (alternate/newer form).
#    REQUIRED: with no id here (and no SUPER_ADMIN_ID) there is NO super admin
#    — config.py warns loudly at startup. Set at least one.
# SUPER_ADMIN_IDS=
#    ADMIN_APPROVAL_RATE — share of a DEPOSIT deducted from the account-owner
#    admin's credit when it is approved (0.9 = 90%). The same rate is credited
#    back to the reviewing admin when a WITHDRAW is approved.
# ADMIN_APPROVAL_RATE=0.9
#    ADMIN_ONLINE_MINUTES — how long an admin stays "online" after activity.
#    Only ONLINE admins' payment accounts are shown to users for deposits.
# ADMIN_ONLINE_MINUTES=5

# ------------------------------------------------------------
#  Local web server (hosts the Mini App + the game loop)
# ------------------------------------------------------------
# SERVER_HOST=127.0.0.1
# SERVER_PORT=5000
# Public URL of the Mini App.
# ⚠️  Telegram REQUIRES https on Web App buttons — http://localhost will be
# rejected ("only https links are allowed"). The easiest fix: run
# setup_tunnel.bat once + run_tunnel.bat (free Cloudflare tunnel, no account)
# — it writes the fresh https URL here automatically. For ngrok, run
# `ngrok http 5000` and paste the URL below.
# APP_URL=http://localhost:5000

# ------------------------------------------------------------
#  Optional game tweaks (defaults shown) — you can leave these commented out
# ------------------------------------------------------------
# DB_PATH=/home/youruser/bingo_data/bingo_bot.db
#   ^ SQLite database file. Use an ABSOLUTE path OUTSIDE the code folder: a
#     deploy that copies the project (zip / folder copy / a repo that tracks a
#     .db) would otherwise overwrite the live database and wipe real accounts.
#     A relative value still works (resolved against the project folder), but
#     then the database sits next to the code. Run `python move_db.py` to move
#     an existing database out safely.
# ROOM_BETS=10                    # ONE room, FIXED bet per card (default: a single “By 10” room)
# MAX_CARDS_PER_PLAYER=3          # max cards a player may hold per round
# NEW_PLAYER_CREDIT=15            # welcome coins for new players
# PRIZE_PERCENT=0.8               # share of the pool paid to the winner
# PREPARATION_SECONDS=40          # countdown before each round
# CALL_INTERVAL_SECONDS=4         # seconds between called numbers
# MIN_CALLS_BEFORE_WIN=10         # minimum balls called before a round can end (early BINGO is gently deferred, never a penalty)
# POST_GAME_RESET_SECONDS=15      # winner screen before next round
# MAX_TOTAL_PLAYERS=18            # informational only — bot count is chosen by human count (see config.BOT_OPTIONS)
# BOT_GUARANTEED_WIN_AFTER=64     # legacy — no longer used; rounds keep normal duration, never shortened for a bot win
# NUM_CARDS=400                   # size of the pre-generated card pool
# ANNOUNCE_NUMBERS=False          # announce every ball in the chat (keep OFF — the Mini App is the main UI)
# ANNOUNCE_ROUNDS=False            # announce round start / winner in the chat (keep OFF for a quiet chat)

# ------------------------------------------------------------
#  Maintenance & reliability — auto housekeeping so the SQLite database never
#  fills the tiny free-tier disk and corrupts itself again (Sep 2026 incident).
# ------------------------------------------------------------
# PRUNE_HISTORY_DAYS=30
#   ^ finished games / old activity / old called balls older than this many days
#     are auto-deleted on every maintenance pass. Running rounds are never
#     touched; the newest PRUNE_KEEP_LATEST_ROWS are always kept for display.
# PRUNE_KEEP_LATEST_ROWS=500
# DB_BACKUP_DIR=/home/youruser/bingo_backups
#   ^ daily snapshot of the whole database is written here (absolute path
#     OUTSIDE the code folder, like DB_PATH). The newest DB_BACKUP_KEEP are kept.
# DB_BACKUP_KEEP=14
# MAINTENANCE_INTERVAL_MIN=360    # how often the maintenance job runs (hours*60)
# MAINTENANCE_MIN_FREE_MB=25      # stop writing when less than this is free
